# Chave da API do Gemini (https://aistudio.google.com/app/apikey)
# Copie este arquivo para .env.local e cole a chave. NUNCA commite a chave real.
GOOGLE_GEMINI_API_KEY=

# Modelo Gemini usado na análise (opcional)
GEMINI_MODEL=gemini-2.5-flash

# URL de checkout do plano PRO
NEXT_PUBLIC_KIWIFY_URL=https://pay.kiwify.com.br/8dq9075
