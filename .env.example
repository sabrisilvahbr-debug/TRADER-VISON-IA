# OPCIONAL. O app funciona sem nenhuma chave no servidor:
# cada usuário cola a própria chave gratuita (https://aistudio.google.com/app/apikey) na tela.
# Só preencha se quiser oferecer uma chave sua como padrão. NUNCA commite a chave real.
GOOGLE_GEMINI_API_KEY=

# Modelo Gemini usado na análise (o gemini-2.5-flash tem cota gratuita)
GEMINI_MODEL=gemini-2.5-flash

# URL de checkout do plano PRO (não usada no momento)
NEXT_PUBLIC_KIWIFY_URL=
